# Copy to .env.local for `vercel dev`. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Shared secret the booths send as "Authorization: Bearer ..." to /api/heartbeat
AGENT_TOKEN=

# Secret you type into the dashboard to read /api/booths
DASHBOARD_TOKEN=

# Upstash Redis (added automatically when you connect Upstash from the Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=
