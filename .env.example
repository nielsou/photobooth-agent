# Copy to .env.local for `vercel dev` (or run `vercel env pull`). Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Shared secret the booths send as "Authorization: Bearer ..." to /api/heartbeat
AGENT_TOKEN=

# Secret you type into the dashboard to read /api/booths
DASHBOARD_TOKEN=

# Redis connection string (added automatically when you connect a Redis
# resource from the Vercel Marketplace / Storage tab)
REDIS_URL=
